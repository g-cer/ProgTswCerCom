# Copiare in .env per personalizzare l'ambiente. Tutti i valori hanno un
# default in compose.yaml: senza .env l'applicazione parte comunque.

# Credenziali del database
MYSQL_ROOT_PASSWORD=root
DB_NAME=keyItaly
DB_USERNAME=keyitaly
DB_PASSWORD=keyitaly

# Porte esposte sull'host
APP_PORT=8080
DB_PORT=3307
